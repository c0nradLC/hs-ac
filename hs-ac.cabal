cabal-version:      3.0
version:            0.1.0.0
name: hs-ac
license:            LGPL-3.0-only
license-file:       LICENSE
author:             c0nradLC
maintainer:         l.conrado10@gmail.com
build-type:         Simple
extra-doc-files:    CHANGELOG.md

common warnings
    ghc-options: -Wall

executable hs-ac
    import:           warnings
    main-is:          Main.hs
    build-depends:    
        base >=4.7 && <5
        , directory <= 1.3.6.2
        , text <1.3
        , bytestring
    hs-source-dirs:   app
    default-language: Haskell2010
