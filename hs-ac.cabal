cabal-version:      3.0
version:            0.1.0.0
name: hs-ac
license:            LGPL-3.0-only
license-file:       LICENSE
author:             c0nradLC
maintainer:         l.conrado10@gmail.com
build-type:         Simple
extra-doc-files:    README.md, CHANGELOG.md

foreign-library hs-ac
    type: native-shared
    lib-version-info: 0
    other-modules:  GLHook
                    , Memory
                    , Offsets
                    , Types
                    , Global
                    , Geom
                    , Window
    ghc-options: -Wall
    build-depends:
        base >=4.7 && <5
        , directory <= 1.3.10.1
        , text <= 1.2.5.0
        , bytestring <= 0.11.4.0
        , unix <= 2.8.8.0
        , OpenGL <= 3.0.3.0
        , sdl2 <= 2.5.5.1
        , dear-imgui <= 2.4.1
    extra-libraries: GL GLU glut
    hs-source-dirs: src
    default-language: Haskell2010
