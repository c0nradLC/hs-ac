cabal-version:      3.0
version:            0.1.0.0
name: hs-ac
license:            LGPL-3.0-only
license-file:       LICENSE
author:             c0nradLC
maintainer:         l.conrado10@gmail.com
build-type:         Simple
extra-doc-files:    CHANGELOG.md

library
    exposed-modules:  GLHook
                    , Memory
                    , Offsets
                    , Types
                    , Global
                    , Geom
    ghc-options: -Wall -dynamic -fPIC -shared -lHSrts-ghc9.2.8 -ldl -no-hs-main -o hs-ac.so
    build-depends:    
        base >=4.7 && <5
        , directory <= 1.3.6.2
        , text <1.3
        , bytestring
        , unix
        , OpenGL
    extra-libraries: GL GLU glut
    hs-source-dirs: src
    default-language: Haskell2010
